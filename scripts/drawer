#!/usr/bin/env bash
set -uo pipefail

drawer_dir="${DRAWER_DIR:-$HOME/.cache/statusbar/fileDrawer}"
duration_ms="${DRAWER_SHOW_MS:-2000}"
mode="copy"
show_statusbar=1
sources=()

usage(){
  printf 'Usage: drawer [--move] [--no-show] [--duration milliseconds] SOURCE...\n'
  printf '\nCopy files, directories or HTTP(S) URLs into the FileDrawer.\n'
}

is_number(){
  [[ "$1" =~ ^[0-9]+$ ]]
}

path_exists(){
  [[ -e "$1" || -L "$1" ]]
}

unique_destination(){
  local original_name="$1"
  local stem="$original_name"
  local extension=""
  local suffix=1
  local dot_index
  local candidate

  dot_index="${original_name##*.}"
  if [[ "$original_name" == *.* && "$original_name" != .* && "$dot_index" != "$original_name" ]]; then
    stem="${original_name%.*}"
    extension=".${dot_index}"
  fi

  candidate="$drawer_dir/$original_name"
  while path_exists "$candidate"; do
    candidate="$drawer_dir/${stem}(${suffix})${extension}"
    suffix=$((suffix+1))
  done

  printf '%s\n' "$candidate"
}

mime_extension(){
  case "${1,,}" in
    image/jpeg)printf '.jpg';;
    image/png)printf '.png';;
    image/gif)printf '.gif';;
    image/webp)printf '.webp';;
    image/avif)printf '.avif';;
    image/svg+xml)printf '.svg';;
    application/pdf)printf '.pdf';;
    video/mp4)printf '.mp4';;
    audio/mpeg)printf '.mp3';;
    *)printf '';;
  esac
}

while (($#>0)); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -t|--duration)
      if (($#<2)) || ! is_number "$2"; then
        printf 'drawer: --duration expects milliseconds\n' >&2
        exit 2
      fi
      duration_ms="$2"
      shift 2
      ;;
    --move)
      mode="move"
      shift
      ;;
    --no-show)
      show_statusbar=0
      shift
      ;;
    --)
      shift
      sources+=("$@")
      break
      ;;
    -* )
      printf 'drawer: unknown option: %s\n' "$1" >&2
      printf 'Try "drawer --help" for usage.\n' >&2
      exit 2
      ;;
    *)
      sources+=("$1")
      shift
      ;;
  esac
done

if ((${#sources[@]}==0)); then
  usage >&2
  exit 2
fi

mkdir -p -- "$drawer_dir"
drawer_realpath="$(realpath -m -- "$drawer_dir")"
success_count=0
failure_count=0

for source in "${sources[@]}"; do
  if [[ "$source" == http://* || "$source" == https://* ]]; then
    download_dir="$(mktemp -d "$drawer_dir/.drawer-download.XXXXXX")"
    if download_info="$(curl --fail --location --silent --show-error \
      --remote-header-name --remote-name --output-dir "$download_dir" \
      --write-out '%{filename_effective}\n%{content_type}' "$source")"; then
      download_name="${download_info%%$'\n'*}"
      mime_type="${download_info#*$'\n'}"
      download_name="$(basename -- "$download_name")"
      [[ -n "$download_name" ]] || download_name="downloaded_file"

      if [[ "$download_name" != *.* ]]; then
        extension="$(mime_extension "${mime_type%%;*}")"
        download_name+="$extension"
      fi

      downloaded_file="$download_dir/$download_name"
      destination="$(unique_destination "$download_name")"
      if [[ -f "$downloaded_file" ]] && mv -- "$downloaded_file" "$destination"; then
        success_count=$((success_count+1))
      else
        printf 'Could not store downloaded URL: %s\n' "$source" >&2
        failure_count=$((failure_count+1))
      fi
    else
      printf 'Could not download URL: %s\n' "$source" >&2
      failure_count=$((failure_count+1))
    fi
    rm -rf -- "$download_dir"
    continue
  fi

  if ! path_exists "$source"; then
    printf 'Not found: %s\n' "$source" >&2
    failure_count=$((failure_count+1))
    continue
  fi

  source_realpath="$(realpath -e -- "$source")"
  if [[ "$source_realpath" == "$drawer_realpath" || "$source_realpath" == "$drawer_realpath"/* ]]; then
    printf 'Already inside the FileDrawer: %s\n' "$source" >&2
    failure_count=$((failure_count+1))
    continue
  fi

  destination="$(unique_destination "$(basename -- "$source_realpath")")"
  if [[ "$mode" == "move" ]]; then
    operation=(mv -- "$source_realpath" "$destination")
  elif [[ -d "$source_realpath" ]]; then
    operation=(cp -R -- "$source_realpath" "$destination")
  else
    operation=(cp -- "$source_realpath" "$destination")
  fi

  if "${operation[@]}"; then
    success_count=$((success_count+1))
  else
    printf 'Could not add: %s\n' "$source" >&2
    failure_count=$((failure_count+1))
  fi
done

if [[ "$mode" == "move" ]]; then
  action="Moved"
else
  action="Copied"
fi
printf '%s %d item%s, %d failed\n' "$action" "$success_count" \
  "$([[ "$success_count" == 1 ]] && printf '' || printf 's')" "$failure_count"

if ((show_statusbar==1&&success_count>0)) && command -v qs >/dev/null 2>&1; then
  if ! qs ipc call statusbar showFor "$duration_ms" >/dev/null 2>&1; then
    printf 'Files processed, but the status bar did not accept IPC\n' >&2
  fi
fi

if ((failure_count>0)); then
  exit 1
fi
